# MySQL connection string used by Prisma
DATABASE_URL="mysql://root:@localhost:3306/cakes_by_tulsi"

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Public origin used to build absolute URLs for uploaded images (defaults to http://localhost:PORT)
# PUBLIC_ASSET_URL=http://localhost:5000

# JWT / session secrets (generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-64-byte-hex-secret
JWT_REFRESH_SECRET=replace-with-a-64-byte-hex-secret
OTP_SESSION_SECRET=replace-with-a-32-byte-hex-secret

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OTP_SESSION_TTL=10m
OTP_TTL_MINUTES=10

# Gmail SMTP (use a Google Account App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Cakes by Tulsi <your-gmail-address@gmail.com>"

# Seeded single-admin account
ADMIN_NAME="Tulsi Admin"
ADMIN_EMAIL=admin@cakesbytulsi.in
ADMIN_PASSWORD=ChangeThisPassword123!
