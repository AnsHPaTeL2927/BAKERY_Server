# Postgres connection strings used by Prisma (Neon, via the Vercel Marketplace
# integration, which injects these two under these exact names).
#
# POSTGRES_PRISMA_URL is the pooled connection (PgBouncer, transaction mode) —
# this is what the app actually connects with at runtime. The pooler is what
# keeps serverless cold starts from exhausting Neon's connection limit, and
# ?pgbouncer=true (already present below) is required so Prisma stops using
# prepared statements, which the pooler does not support.
POSTGRES_PRISMA_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# DATABASE_URL_UNPOOLED is the direct connection, used only by
# `prisma migrate` / `prisma db push` — migrations take advisory locks that
# transaction pooling silently drops, which can leave a migration
# half-applied if run through the pooler.
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Only needed once, by `npm run db:export`, to read the OLD MySQL database
# during the migration. Safe to delete afterwards.
# MYSQL_DATABASE_URL="mysql://root:@localhost:3306/cakes_by_tulsi"

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. In production list BOTH the
# apex and the www host, or CORS will reject whichever one is missing.
FRONTEND_URL=http://localhost:5173
# FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com
# Public origin used to build absolute URLs for uploaded images (defaults to http://localhost:PORT).
# REQUIRED in production — the server refuses to boot without it, because it no longer
# trusts the request's Host/X-Forwarded-Host headers to build those URLs.
# PUBLIC_ASSET_URL=http://localhost:5000

# Image storage. Set = images go to Vercel Blob; unset = images go to the local
# uploads/ directory. Vercel injects this automatically once a Blob store is
# linked to the project, so it is only set by hand for local Blob testing or
# for running `npm run blob:migrate`.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Shared secret guarding /api/cron/expire-offers, which Vercel Cron calls daily
# in place of the in-process node-cron schedule. Vercel injects this
# automatically once set in the project's environment variables.
# CRON_SECRET=generate-a-long-random-string

# Keep-alive self-ping for free hosting tiers that sleep when idle.
# Ignored on Vercel (nothing sleeps, and there is no long-lived process to ping
# from) — this is only for Render/Railway-style hosts.
# KEEP_ALIVE_URL=https://your-api-host.onrender.com/health
# KEEP_ALIVE_INTERVAL_MINUTES=10

# JWT / session secrets (generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-a-64-byte-hex-secret
JWT_REFRESH_SECRET=replace-with-a-64-byte-hex-secret
OTP_SESSION_SECRET=replace-with-a-32-byte-hex-secret

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OTP_SESSION_TTL=10m
OTP_TTL_MINUTES=10

# Gmail SMTP (use a Google Account App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Cakes by Tulsi <your-gmail-address@gmail.com>"

# Optional — only read once by `npm run seed` to bootstrap the very first
# admin account on a brand new database. Not required otherwise: admin
# credentials live in the database from then on, managed via the admin
# panel's "Forgot Password" flow. Safe to remove after the first seed.
ADMIN_NAME="Tulsi Admin"
ADMIN_EMAIL=admin@cakesbytulsi.in
ADMIN_PASSWORD=ChangeThisPassword123!
